/* 全局样式 */
page {
  --primary-color: #FF6B6B;
  --secondary-color: #4ECDC4;
  --gold-color: #FFD700;
  --silver-color: #C0C0C0;
  --bronze-color: #CD7F32;
  --bg-color: #f5f5f5;
  --text-color: #333333;
  --text-light: #666666;
  --border-color: #e0e0e0;
  
  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 通用卡片样式 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border: none;
}

.btn-secondary {
  background: #f0f0f0;
  color: #666666;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border: none;
}

/* 文本样式 */
.text-primary {
  color: var(--primary-color);
}

.text-gold {
  color: var(--gold-color);
}

.text-silver {
  color: var(--silver-color);
}

.text-bronze {
  color: var(--bronze-color);
}

/* 布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999999;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999999;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}
