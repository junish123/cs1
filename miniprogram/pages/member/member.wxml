<view class="container">
  <!-- 会员卡片 -->
  <view class="member-card">
    <view class="card-bg"></view>
    <view class="member-info">
      <view class="avatar-wrapper">
        <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="level-tag">{{memberInfo.levelName || '普通会员'}}</view>
      </view>
      <view class="info-content">
        <text class="nickname">{{userInfo.nickName || '微信用户'}}</text>
        <text class="member-no">会员号: {{memberInfo.memberNo || '000001'}}</text>
      </view>
      <view class="qr-btn" bindtap="showMemberCode">
        <text class="iconfont icon-qrcode"></text>
        <text class="qr-text">会员码</text>
      </view>
    </view>
    
    <view class="stats-row">
      <view class="stat-item" bindtap="goToPoints">
        <text class="stat-value">{{memberInfo.points || 0}}</text>
        <text class="stat-label">积分</text>
      </view>
      <view class="stat-item" bindtap="goToBalance">
        <text class="stat-value">{{memberInfo.balance || 0}}</text>
        <text class="stat-label">余额</text>
      </view>
      <view class="stat-item" bindtap="goToCoupons">
        <text class="stat-value">{{couponCount || 0}}</text>
        <text class="stat-label">优惠券</text>
      </view>
      <view class="stat-item" bindtap="goToCollect">
        <text class="stat-value">{{collectCount || 0}}</text>
        <text class="stat-label">收藏</text>
      </view>
    </view>
  </view>

  <!-- 我的订单 -->
  <view class="section">
    <view class="section-header" bindtap="goToOrders">
      <text class="section-title">我的订单</text>
      <text class="section-more">查看全部 ></text>
    </view>
    <view class="order-types">
      <view class="order-item" bindtap="goToOrders" data-type="unpaid">
        <view class="order-icon-wrapper">
          <text class="iconfont icon-wallet"></text>
          <text class="badge" wx:if="{{unpaidCount > 0}}">{{unpaidCount}}</text>
        </view>
        <text class="order-label">待付款</text>
      </view>
      <view class="order-item" bindtap="goToOrders" data-type="unshipped">
        <view class="order-icon-wrapper">
          <text class="iconfont icon-box"></text>
          <text class="badge" wx:if="{{unshippedCount > 0}}">{{unshippedCount}}</text>
        </view>
        <text class="order-label">待发货</text>
      </view>
      <view class="order-item" bindtap="goToOrders" data-type="unreceived">
        <view class="order-icon-wrapper">
          <text class="iconfont icon-truck"></text>
          <text class="badge" wx:if="{{unreceivedCount > 0}}">{{unreceivedCount}}</text>
        </view>
        <text class="order-label">待收货</text>
      </view>
      <view class="order-item" bindtap="goToOrders" data-type="unreviewed">
        <view class="order-icon-wrapper">
          <text class="iconfont icon-comment"></text>
          <text class="badge" wx:if="{{unreviewedCount > 0}}">{{unreviewedCount}}</text>
        </view>
        <text class="order-label">待评价</text>
      </view>
      <view class="order-item" bindtap="goToAfterSale">
        <view class="order-icon-wrapper">
          <text class="iconfont icon-service"></text>
        </view>
        <text class="order-label">退款/售后</text>
      </view>
    </view>
  </view>

  <!-- 会员功能 -->
  <view class="section">
    <view class="section-title">会员服务</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToVipLevel">
        <view class="menu-icon" style="background: linear-gradient(135deg, #FFD700, #FFA500);">
          <text class="iconfont icon-crown"></text>
        </view>
        <view class="menu-content">
          <text class="menu-title">会员等级</text>
          <text class="menu-desc">等级权益与升级规则</text>
        </view>
        <text class="iconfont icon-arrow-right"></text>
      </view>
      
      <view class="menu-item" bindtap="goToSignIn">
        <view class="menu-icon" style="background: linear-gradient(135deg, #E94560, #FF6B6B);">
          <text class="iconfont icon-calendar"></text>
        </view>
        <view class="menu-content">
          <text class="menu-title">每日签到</text>
          <text class="menu-desc">签到领积分，连续翻倍</text>
        </view>
        <text class="iconfont icon-arrow-right"></text>
      </view>
      
      <view class="menu-item" bindtap="goToPointDetail">
        <view class="menu-icon" style="background: linear-gradient(135deg, #F72585, #B5179E);">
          <text class="iconfont icon-points"></text>
        </view>
        <view class="menu-content">
          <text class="menu-title">积分明细</text>
          <text class="menu-desc">查看积分收支记录</text>
        </view>
        <text class="iconfont icon-arrow-right"></text>
      </view>
      
      <view class="menu-item" bindtap="goToParking">
        <view class="menu-icon" style="background: linear-gradient(135deg, #4361EE, #3A0CA3);">
          <text class="iconfont icon-parking"></text>
        </view>
        <view class="menu-content">
          <text class="menu-title">停车服务</text>
          <text class="menu-desc">缴费、记录、车牌管理</text>
        </view>
        <text class="iconfont icon-arrow-right"></text>
      </view>
      
      <view class="menu-item" bindtap="goToInvite">
        <view class="menu-icon" style="background: linear-gradient(135deg, #06D6A0, #118AB2);">
          <text class="iconfont icon-share"></text>
        </view>
        <view class="menu-content">
          <text class="menu-title">邀请好友</text>
          <text class="menu-desc">邀请得积分奖励</text>
        </view>
        <text class="iconfont icon-arrow-right"></text>
      </view>
    </view>
  </view>

  <!-- 更多服务 -->
  <view class="section">
    <view class="section-title">更多服务</view>
    <view class="service-grid">
      <view class="service-item" bindtap="goToService">
        <text class="iconfont icon-service"></text>
        <text class="service-name">客服中心</text>
      </view>
      <view class="service-item" bindtap="goToSetting">
        <text class="iconfont icon-setting"></text>
        <text class="service-name">设置</text>
      </view>
    </view>
  </view>
</view>
