<!-- 会员中心页面 -->
<view class="container">
  <!-- 会员信息卡片 -->
  <view class="member-header">
    <view class="member-profile">
      <image class="avatar-large" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"/>
      <view class="profile-info">
        <text class="nickname">{{userInfo.nickName || '游客'}}</text>
        <view class="member-tag level-{{memberInfo.level}}">
          <text>{{memberInfo.levelName || '普通会员'}}</text>
        </view>
      </view>
    </view>
    <view class="member-stats">
      <view class="stat-box">
        <text class="stat-num">{{memberInfo.points || 0}}</text>
        <text class="stat-label">积分</text>
      </view>
      <view class="stat-box">
        <text class="stat-num">{{memberInfo.balance || 0}}</text>
        <text class="stat-label">余额</text>
      </view>
      <view class="stat-box">
        <text class="stat-num">{{memberInfo.totalSpend || 0}}</text>
        <text class="stat-label">累计消费</text>
      </view>
    </view>
  </view>
  
  <!-- 会员等级 -->
  <view class="card">
    <view class="card-title">会员等级特权</view>
    <view class="privilege-list">
      <view class="privilege-item">
        <view class="privilege-icon">积分</view>
        <text class="privilege-name">积分加速</text>
        <text class="privilege-desc">消费享{{memberInfo.level >= 3 ? '2' : memberInfo.level >= 2 ? '1.5' : '1'}}倍积分</text>
      </view>
      <view class="privilege-item">
        <view class="privilege-icon">生日</view>
        <text class="privilege-name">生日礼包</text>
        <text class="privilege-desc">生日当月送优惠券</text>
      </view>
      <view class="privilege-item">
        <view class="privilege-icon">专属</view>
        <text class="privilege-name">专属优惠</text>
        <text class="privilege-desc">会员专享折扣</text>
      </view>
      <view class="privilege-item">
        <view class="privilege-icon">优先</view>
        <text class="privilege-name">优先服务</text>
        <text class="privilege-desc">尊享优先通道</text>
      </view>
    </view>
  </view>
  
  <!-- 功能菜单 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToRecords">
      <view class="menu-icon record-icon">
        <text>记录</text>
      </view>
      <text class="menu-text">消费记录</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToPoints">
      <view class="menu-icon points-icon">
        <text>积分</text>
      </view>
      <text class="menu-text">积分明细</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToCoupons">
      <view class="menu-icon coupon-icon">
        <text>领券</text>
      </view>
      <text class="menu-text">领券中心</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="showMemberCode">
      <view class="menu-icon code-icon">
        <text>会员</text>
      </view>
      <text class="menu-text">会员二维码</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="contactService">
      <view class="menu-icon service-icon">
        <text>客服</text>
      </view>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
  
  <!-- 退出登录 -->
  <view class="logout-btn" bindtap="logout">
    <text>退出登录</text>
  </view>
</view>
