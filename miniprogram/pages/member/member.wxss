/* 会员中心样式 */
.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 会员头部 */
.member-header {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.member-profile {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-large {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 24rpx;
}

.profile-info {
  flex: 1;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.member-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.3);
}

.member-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-box {
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
  display: block;
}

/* 特权列表 */
.card {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.privilege-list {
  display: flex;
  flex-wrap: wrap;
}

.privilege-item {
  width: 25%;
  text-align: center;
  padding: 20rpx 0;
}

.privilege-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin: 0 auto 12rpx;
}

.privilege-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.privilege-desc {
  font-size: 20rpx;
  color: #999;
}

/* 菜单列表 */
.menu-list {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  margin-right: 20rpx;
}

.record-icon { background: linear-gradient(135deg, #667eea, #764ba2); }
.points-icon { background: linear-gradient(135deg, #FF6B6B, #FF8E8E); }
.coupon-icon { background: linear-gradient(135deg, #4ECDC4, #44A08D); }
.code-icon { background: linear-gradient(135deg, #f093fb, #f5576c); }
.service-icon { background: linear-gradient(135deg, #fa709a, #fee140); }

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 退出登录 */
.logout-btn {
  margin: 40rpx 20rpx;
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  text-align: center;
}

.logout-btn text {
  font-size: 30rpx;
  color: #FF6B6B;
}
