/* 会员中心页面样式 */
.container {
  background: #F5F7FA;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 会员卡片 */
.member-card {
  margin: 20rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #1A1A2E 0%, #16213E 100%);
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(26, 26, 46, 0.3);
}

.card-bg {
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(233, 69, 96, 0.2) 0%, transparent 70%);
}

.member-info {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
  margin-bottom: 30rpx;
}

.avatar-wrapper {
  position: relative;
  margin-right: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.level-tag {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #1A1A2E;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.info-content {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
  display: block;
}

.member-no {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.qr-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
}

.qr-btn .iconfont {
  font-size: 48rpx;
  color: #fff;
  margin-bottom: 4rpx;
}

.qr-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 统计行 */
.stats-row {
  display: flex;
  justify-content: space-around;
  position: relative;
  z-index: 2;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 通用区块 */
.section {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

/* 订单类型 */
.order-types {
  display: flex;
  justify-content: space-between;
}

.order-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-icon-wrapper {
  position: relative;
  margin-bottom: 12rpx;
}

.order-icon-wrapper .iconfont {
  font-size: 48rpx;
  color: #666;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #E94560;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-label {
  font-size: 24rpx;
  color: #666;
}

/* 菜单列表 */
.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.menu-icon .iconfont {
  font-size: 36rpx;
  color: #fff;
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
  display: block;
}

.menu-desc {
  font-size: 24rpx;
  color: #999;
}

.menu-item > .iconfont {
  font-size: 28rpx;
  color: #CCC;
}

/* 服务网格 */
.service-grid {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
}

.service-item .iconfont {
  font-size: 48rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.service-name {
  font-size: 24rpx;
  color: #666;
}
