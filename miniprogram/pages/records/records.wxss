/* 消费记录样式 */
.container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  padding: 40rpx;
  display: flex;
  justify-content: space-around;
}

.stats-item {
  text-align: center;
  color: #fff;
}

.stats-num {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
}

.stats-label {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 10rpx;
  display: block;
}

/* 记录列表 */
.records-section {
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.record-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.record-type {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  margin-right: 20rpx;
}

.record-type.consume {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
}

.record-type.recharge {
  background: linear-gradient(135deg, #4ECDC4, #44A08D);
}

.record-type.refund {
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.record-info {
  flex: 1;
}

.record-title {
  font-size: 30rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-right {
  text-align: right;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
}

.record-amount.consume {
  color: #333;
}

.record-amount.recharge {
  color: #4ECDC4;
}

.record-amount.refund {
  color: #667eea;
}

.record-points {
  font-size: 24rpx;
  color: #FF6B6B;
  margin-top: 6rpx;
  display: block;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
  font-size: 28rpx;
  background: #fff;
  border-radius: 16rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 28rpx;
}
