<!-- 消费记录页面 -->
<view class="container">
  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stats-item">
      <text class="stats-num">{{totalCount}}</text>
      <text class="stats-label">消费次数</text>
    </view>
    <view class="stats-item">
      <text class="stats-num">¥{{totalAmount}}</text>
      <text class="stats-label">消费总额</text>
    </view>
  </view>
  
  <!-- 记录列表 -->
  <view class="records-section">
    <view class="section-title">消费明细</view>
    <view class="record-list">
      <view class="record-item" wx:for="{{records}}" wx:key="_id">
        <view class="record-left">
          <view class="record-type {{item.type}}">
            <text>{{item.typeName}}</text>
          </view>
          <view class="record-info">
            <text class="record-title">{{item.title}}</text>
            <text class="record-time">{{item.createTime}}</text>
          </view>
        </view>
        <view class="record-right">
          <text class="record-amount {{item.type}}">
            {{item.type === 'consume' ? '-' : '+'}}{{item.amount}}
          </text>
          <text class="record-points" wx:if="{{item.points > 0}}">
            +{{item.points}}积分
          </text>
        </view>
      </view>
    </view>
    
    <view class="empty" wx:if="{{records.length === 0}}">
      <text>暂无消费记录</text>
    </view>
    
    <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">
      <text>加载更多</text>
    </view>
  </view>
</view>
