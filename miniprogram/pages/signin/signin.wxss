.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 头部样式 */
.signin-header {
  position: relative;
  background: linear-gradient(135deg, #1A1A2E 0%, #16213E 50%, #0F3460 100%);
  padding: 60rpx 40rpx;
  text-align: center;
  color: #fff;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(233,69,96,0.2) 0%, transparent 70%);
  animation: pulse 3s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.1); opacity: 0.8; }
}

.points-display {
  position: relative;
  z-index: 1;
  margin-bottom: 40rpx;
}

.points-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 10rpx;
}

.points-value {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.signin-btn {
  position: relative;
  z-index: 1;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #E94560, #FF6B6B);
  border-radius: 50%;
  box-shadow: 0 10rpx 40rpx rgba(233, 69, 96, 0.4);
  animation: breathe 2s ease-in-out infinite;
}

.signin-btn.signed {
  background: #06D6A0;
  box-shadow: 0 10rpx 40rpx rgba(6, 214, 160, 0.4);
  animation: none;
}

@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.btn-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.btn-points {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
}

/* 区块样式 */
.section {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

/* 连续签到 */
.consecutive-days {
  text-align: center;
  margin-bottom: 10rpx;
}

.days-num {
  font-size: 64rpx;
  font-weight: bold;
  color: #E94560;
}

.days-text {
  font-size: 32rpx;
  color: #666;
  margin-left: 10rpx;
}

.consecutive-tip {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}

/* 签到进度 */
.signin-progress {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
}

.progress-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.progress-item::after {
  content: '';
  position: absolute;
  top: 24rpx;
  right: -60%;
  width: 80%;
  height: 4rpx;
  background: #e0e0e0;
}

.progress-item:last-child::after {
  display: none;
}

.progress-item.signed::after {
  background: #06D6A0;
}

.day-circle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
}

.progress-item.signed .day-circle {
  background: #06D6A0;
}

.progress-item.today .day-circle {
  border-color: #E94560;
  background: rgba(233, 69, 96, 0.1);
}

.day-circle .iconfont {
  font-size: 28rpx;
  color: #fff;
}

.day-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.day-points {
  font-size: 20rpx;
  color: #E94560;
  background: rgba(233, 69, 96, 0.1);
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

/* 月份选择器 */
.month-selector {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.month-selector .iconfont {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx;
}

.current-month {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 星期标题 */
.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.week-header text {
  font-size: 26rpx;
  color: #999;
}

/* 日历网格 */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 16rpx;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #f8f8f8;
  position: relative;
}

.calendar-day.empty {
  background: transparent;
}

.calendar-day.signed {
  background: rgba(6, 214, 160, 0.1);
}

.calendar-day.today {
  border: 2rpx solid #E94560;
}

.day-num {
  font-size: 28rpx;
  color: #333;
}

.calendar-day.signed .day-num {
  color: #06D6A0;
}

.sign-mark {
  position: absolute;
  bottom: 8rpx;
  font-size: 20rpx;
  color: #06D6A0;
}

/* 奖励列表 */
.reward-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reward-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.reward-item.achieved {
  background: rgba(6, 214, 160, 0.1);
  border-color: #06D6A0;
}

.reward-icon {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.reward-icon .iconfont {
  font-size: 36rpx;
  color: #fff;
}

.reward-info {
  flex: 1;
}

.reward-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.reward-desc {
  font-size: 24rpx;
  color: #999;
}

.reward-status {
  font-size: 24rpx;
  color: #999;
}

.reward-item.achieved .reward-status {
  color: #06D6A0;
}

/* 规则列表 */
.rules-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.rule-num {
  width: 36rpx;
  height: 36rpx;
  background: #E94560;
  color: #fff;
  font-size: 22rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rule-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
