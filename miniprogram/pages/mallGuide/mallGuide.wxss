/* 商场导览页面样式 */
.container {
  background: #F5F7FA;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 商场头部 */
.mall-header {
  position: relative;
}

.mall-cover {
  width: 100%;
  height: 300rpx;
}

.mall-info {
  padding: 30rpx;
  background: #fff;
}

.mall-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 12rpx;
  display: block;
}

.mall-meta {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #666;
}

.mall-location {
  display: flex;
  align-items: center;
}

.mall-location .iconfont {
  font-size: 28rpx;
  color: #E94560;
  margin-right: 8rpx;
}

.location-text {
  font-size: 26rpx;
  color: #999;
}

/* 楼层标签 */
.floor-tabs {
  background: #fff;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #F0F0F0;
}

.floor-scroll {
  white-space: nowrap;
}

.floor-list {
  display: inline-flex;
  gap: 20rpx;
}

.floor-item {
  padding: 16rpx 40rpx;
  background: #F5F7FA;
  border-radius: 32rpx;
}

.floor-item.active {
  background: linear-gradient(135deg, #E94560, #FF6B6B);
}

.floor-text {
  font-size: 30rpx;
  color: #666;
}

.floor-item.active .floor-text {
  color: #fff;
  font-weight: 600;
}

/* 楼层业态 */
.floor-categories {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx;
  background: #fff;
  gap: 30rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 18%;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.category-icon .iconfont {
  font-size: 40rpx;
  color: #fff;
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

/* 店铺区域 */
.shop-section {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 24rpx;
  display: block;
}

.shop-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.shop-card {
  display: flex;
  padding: 24rpx;
  background: #F8F9FA;
  border-radius: 20rpx;
}

.shop-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.shop-info {
  flex: 1;
}

.shop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.shop-category {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

.shop-tags {
  display: flex;
  gap: 8rpx;
}

.shop-tag {
  font-size: 20rpx;
  color: #E94560;
  background: rgba(233, 69, 96, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.shop-action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
}

.shop-location {
  font-size: 24rpx;
  color: #999;
}

.nav-btn {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #4361EE, #3A0CA3);
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  border: none;
  line-height: 1.5;
}

.nav-btn::after {
  border: none;
}

/* 设施服务 */
.facility-section {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 24rpx;
}

.facility-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.facility-item {
  width: 30%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #F8F9FA;
  border-radius: 20rpx;
}

.facility-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #E94560, #FF6B6B);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.facility-icon .iconfont {
  font-size: 32rpx;
  color: #fff;
}

.facility-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.facility-location {
  font-size: 22rpx;
  color: #999;
}
