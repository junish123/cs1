<view class="container">
  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <text class="iconfont icon-search"></text>
      <input type="text" class="search-input" placeholder="搜索话题、用户、店铺" bindinput="onSearchInput" />
    </view>
    <view class="publish-btn" bindtap="goToPublish">
      <text class="iconfont icon-camera"></text>
      <text class="publish-text">发布</text>
    </view>
  </view>

  <!-- 话题标签 -->
  <view class="topic-section">
    <scroll-view scroll-x="true" class="topic-scroll">
      <view class="topic-list">
        <view class="topic-item {{currentTopic === 'all' ? 'active' : ''}}" bindtap="switchTopic" data-topic="all">
          <text class="topic-text">推荐</text>
        </view>
        <view class="topic-item {{currentTopic === item.id ? 'active' : ''}}" wx:for="{{topics}}" wx:key="id" bindtap="switchTopic" data-topic="{{item.id}}">
          <text class="topic-text">{{item.name}}</text>
          <text class="topic-count">{{item.count}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 内容流 - 瀑布流布局 -->
  <view class="content-section">
    <view class="waterfall">
      <view class="waterfall-column">
        <view class="post-card" wx:for="{{leftPosts}}" wx:key="id" bindtap="goToPostDetail" data-id="{{item.id}}">
          <image src="{{item.images[0]}}" mode="widthFix" class="post-image"></image>
          <view class="post-content">
            <text class="post-title">{{item.title}}</text>
            <view class="post-tags">
              <text class="post-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</text>
            </view>
            <view class="post-footer">
              <view class="post-author">
                <image src="{{item.authorAvatar}}" class="author-avatar"></image>
                <text class="author-name">{{item.authorName}}</text>
              </view>
              <view class="post-stats">
                <text class="iconfont icon-like"></text>
                <text class="stat-num">{{item.likes}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="waterfall-column">
        <view class="post-card" wx:for="{{rightPosts}}" wx:key="id" bindtap="goToPostDetail" data-id="{{item.id}}">
          <image src="{{item.images[0]}}" mode="widthFix" class="post-image"></image>
          <view class="post-content">
            <text class="post-title">{{item.title}}</text>
            <view class="post-tags">
              <text class="post-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</text>
            </view>
            <view class="post-footer">
              <view class="post-author">
                <image src="{{item.authorAvatar}}" class="author-avatar"></image>
                <text class="author-name">{{item.authorName}}</text>
              </view>
              <view class="post-stats">
                <text class="iconfont icon-like"></text>
                <text class="stat-num">{{item.likes}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text class="load-text">加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && posts.length > 0}}">
    <text class="no-more-text">已经到底啦</text>
  </view>
</view>
