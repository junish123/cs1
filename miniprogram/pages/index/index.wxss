/* 首页样式 */
.container {
  padding-bottom: 40rpx;
}

/* 会员卡片 */
.member-card {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  border-radius: 0 0 40rpx 40rpx;
  padding: 40rpx 30rpx;
  color: #ffffff;
  margin: 0 0 20rpx 0;
}

.member-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 20rpx;
}

.member-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.level-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.3);
}

.level-1 { background: #C0C0C0; }
.level-2 { background: #E8E8E8; color: #666; }
.level-3 { background: linear-gradient(135deg, #FFD700, #FFA500); }
.level-4 { background: linear-gradient(135deg, #00CED1, #20B2AA); }

.qr-code {
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 等级进度 */
.level-progress {
  margin-top: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.card-subtitle {
  font-size: 24rpx;
  color: #999;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B6B, #FFD93D);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.level-list {
  display: flex;
  justify-content: space-between;
}

.level-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.level-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background: #ddd;
  margin-bottom: 8rpx;
}

.level-item.active .level-dot {
  background: #FF6B6B;
}

.level-name {
  font-size: 24rpx;
  color: #999;
}

.level-item.active .level-name {
  color: #FF6B6B;
  font-weight: bold;
}

/* 快捷入口 */
.quick-actions {
  margin-top: 20rpx;
}

.action-grid {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  margin-bottom: 12rpx;
}

.points-icon { background: linear-gradient(135deg, #FF6B6B, #FF8E8E); }
.coupon-icon { background: linear-gradient(135deg, #4ECDC4, #44A08D); }
.record-icon { background: linear-gradient(135deg, #667eea, #764ba2); }
.scan-icon { background: linear-gradient(135deg, #f093fb, #f5576c); }

.action-text {
  font-size: 26rpx;
  color: #666;
}

/* 优惠券列表 */
.more {
  font-size: 26rpx;
  color: #999;
}

.coupon-list {
  margin-top: 20rpx;
}

.coupon-item {
  display: flex;
  align-items: center;
  background: #fff8f8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #ffe0e0;
}

.coupon-left {
  width: 160rpx;
  text-align: center;
  border-right: 2rpx dashed #ffd0d0;
  padding-right: 20rpx;
}

.coupon-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
  display: block;
}

.coupon-condition {
  font-size: 22rpx;
  color: #999;
}

.coupon-right {
  flex: 1;
  padding: 0 20rpx;
}

.coupon-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.coupon-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.coupon-time {
  font-size: 22rpx;
  color: #999;
}

.coupon-btn {
  background: #FF6B6B;
  color: #fff;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 积分商品 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.product-item {
  width: calc(33.33% - 20rpx);
  margin: 10rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 160rpx;
  background: #eee;
}

.product-name {
  font-size: 24rpx;
  color: #333;
  padding: 10rpx;
  display: block;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-points {
  text-align: center;
  padding-bottom: 16rpx;
}

.points-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.points-label {
  font-size: 22rpx;
  color: #999;
}
