/* 首页样式 - 印享星风格 */
.container {
  background: #F5F7FA;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 会员身份卡 */
.vip-card {
  margin: 20rpx;
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(26, 26, 46, 0.3);
}

.vip-card-content {
  padding: 40rpx 30rpx;
  position: relative;
  z-index: 2;
}

.card-decoration {
  position: absolute;
  right: -100rpx;
  top: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(233, 69, 96, 0.15) 0%, transparent 70%);
  z-index: 1;
}

.vip-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.vip-info {
  display: flex;
  align-items: center;
}

.vip-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 20rpx;
}

.vip-text {
  display: flex;
  flex-direction: column;
}

.vip-name {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.vip-level {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.level-tag {
  font-size: 22rpx;
  color: #FFD700;
  background: rgba(255, 215, 0, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.3);
}

.vip-no {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}

.vip-qr {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
}

.vip-qr .iconfont {
  font-size: 48rpx;
  color: #fff;
  margin-bottom: 4rpx;
}

.qr-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* VIP统计 */
.vip-stats {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 成长值进度 */
.growth-section {
  margin-top: 20rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
}

.growth-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.growth-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.growth-tip {
  font-size: 22rpx;
  color: #FFD700;
}

.growth-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
  overflow: hidden;
}

.growth-progress {
  height: 100%;
  background: linear-gradient(90deg, #E94560, #FFD700);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

/* 快捷功能区 */
.quick-actions {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.action-item {
  width: 30%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.action-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.action-icon .iconfont {
  font-size: 48rpx;
  color: #fff;
}

.action-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 轮播广告 */
.banner-section {
  margin: 20rpx;
}

.banner-swiper {
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 通用区块样式 */
.section {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #E94560, #FF6B6B);
  border-radius: 3rpx;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

/* 热门活动 */
.event-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.event-card {
  display: flex;
  background: #F8F9FA;
  border-radius: 20rpx;
  overflow: hidden;
}

.event-image {
  width: 200rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.event-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.event-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.event-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.event-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.event-location {
  font-size: 24rpx;
  color: #666;
}

.event-status {
  font-size: 22rpx;
  color: #999;
  background: #E8E8E8;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.event-status.active {
  color: #E94560;
  background: rgba(233, 69, 96, 0.1);
}

/* 推荐店铺 */
.shop-scroll {
  white-space: nowrap;
}

.shop-list {
  display: inline-flex;
  gap: 20rpx;
}

.shop-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}

.shop-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.shop-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.shop-category {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 积分任务 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F8F9FA;
  border-radius: 20rpx;
}

.task-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #E94560, #FF6B6B);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.task-icon .iconfont {
  font-size: 40rpx;
  color: #fff;
}

.task-content {
  flex: 1;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.task-desc {
  font-size: 24rpx;
  color: #999;
}

.task-reward {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

.reward-points {
  font-size: 36rpx;
  font-weight: 700;
  color: #E94560;
}

.reward-label {
  font-size: 22rpx;
  color: #999;
}

.task-btn {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #E94560, #FF6B6B);
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  border: none;
  line-height: 1.5;
}

.task-btn.completed {
  background: #CCC;
}

.task-btn::after {
  border: none;
}
