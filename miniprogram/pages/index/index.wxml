<view class="container">
  <!-- 顶部会员身份卡 -->
  <view class="vip-card" style="background: linear-gradient(135deg, #1A1A2E 0%, #16213E 50%, #0F3460 100%);">
    <view class="vip-card-content">
      <view class="vip-header">
        <view class="vip-info">
          <image class="vip-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="vip-text">
            <text class="vip-name">{{userInfo.nickName || '微信用户'}}</text>
            <view class="vip-level">
              <text class="level-tag">{{memberInfo.levelName || '普通会员'}}</text>
              <text class="vip-no">NO.{{memberInfo.memberNo || '000001'}}</text>
            </view>
          </view>
        </view>
        <view class="vip-qr" bindtap="showMemberCode">
          <text class="iconfont icon-qrcode"></text>
          <text class="qr-text">会员码</text>
        </view>
      </view>
      
      <view class="vip-stats">
        <view class="stat-item" bindtap="goToPoints">
          <text class="stat-value">{{memberInfo.points || 0}}</text>
          <text class="stat-label">积分</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="goToCoupons">
          <text class="stat-value">{{couponCount || 0}}</text>
          <text class="stat-label">优惠券</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{memberInfo.balance || 0}}</text>
          <text class="stat-label">余额(元)</text>
        </view>
      </view>
      
      <!-- 成长值进度 -->
      <view class="growth-section" wx:if="{{memberInfo.nextLevel}}">
        <view class="growth-header">
          <text class="growth-text">距{{memberInfo.nextLevel}}还需消费 ¥{{memberInfo.needAmount || 0}}</text>
          <text class="growth-tip">积分倍数 x{{memberInfo.pointMultiplier || 1}}</text>
        </view>
        <view class="growth-bar">
          <view class="growth-progress" style="width: {{memberInfo.growthProgress || 0}}%;"></view>
        </view>
      </view>
    </view>
    
    <!-- 装饰元素 -->
    <view class="card-decoration"></view>
  </view>

  <!-- 快捷功能区 -->
  <view class="quick-actions">
    <view class="action-grid">
      <view class="action-item" bindtap="goToSignIn">
        <view class="action-icon" style="background: linear-gradient(135deg, #FFD700, #FFA500);">
          <text class="iconfont icon-calendar"></text>
        </view>
        <text class="action-text">每日签到</text>
      </view>
      <view class="action-item" bindtap="goToCouponCenter">
        <view class="action-icon" style="background: linear-gradient(135deg, #E94560, #FF6B6B);">
          <text class="iconfont icon-coupon"></text>
        </view>
        <text class="action-text">领券中心</text>
      </view>
      <view class="action-item" bindtap="scanCode">
        <view class="action-icon" style="background: linear-gradient(135deg, #06D6A0, #118AB2);">
          <text class="iconfont icon-scan"></text>
        </view>
        <text class="action-text">扫码积分</text>
      </view>
      <view class="action-item" bindtap="goToParking">
        <view class="action-icon" style="background: linear-gradient(135deg, #4361EE, #3A0CA3);">
          <text class="iconfont icon-parking"></text>
        </view>
        <text class="action-text">停车缴费</text>
      </view>
      <view class="action-item" bindtap="goToPointShop">
        <view class="action-icon" style="background: linear-gradient(135deg, #F72585, #B5179E);">
          <text class="iconfont icon-gift"></text>
        </view>
        <text class="action-text">积分商城</text>
      </view>
      <view class="action-item" bindtap="goToMallGuide">
        <view class="action-icon" style="background: linear-gradient(135deg, #4CC9F0, #4895EF);">
          <text class="iconfont icon-map"></text>
        </view>
        <text class="action-text">商场导览</text>
      </view>
      <view class="action-item" bindtap="goToVipLevel">
        <view class="action-icon" style="background: linear-gradient(135deg, #9B5DE5, #7209B7);">
          <text class="iconfont icon-vip"></text>
        </view>
        <text class="action-text">会员等级</text>
      </view>
      <view class="action-item" bindtap="goToRecords">
        <view class="action-icon" style="background: linear-gradient(135deg, #F8961E, #F3722C);">
          <text class="iconfont icon-record"></text>
        </view>
        <text class="action-text">消费记录</text>
      </view>
    </view>
  </view>

  <!-- 轮播广告 -->
  <view class="banner-section">
    <swiper class="banner-swiper" indicator-dots="true" autoplay="true" interval="3000" duration="500" circular="true">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <image src="{{item.image}}" mode="aspectFill" class="banner-image" bindtap="onBannerTap" data-id="{{item.id}}"></image>
      </swiper-item>
    </swiper>
  </view>

  <!-- 热门活动 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">热门活动</text>
      <text class="section-more" bindtap="goToMoreEvents">更多 ></text>
    </view>
    <view class="event-list">
      <view class="event-card" wx:for="{{events}}" wx:key="id" bindtap="onEventTap" data-id="{{item.id}}">
        <image src="{{item.cover}}" mode="aspectFill" class="event-image"></image>
        <view class="event-info">
          <text class="event-title">{{item.title}}</text>
          <text class="event-time">{{item.time}}</text>
          <view class="event-footer">
            <text class="event-location">{{item.location}}</text>
            <text class="event-status {{item.status === '报名中' ? 'active' : ''}}">{{item.status}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 推荐店铺 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">推荐店铺</text>
      <text class="section-more" bindtap="goToMoreShops">更多 ></text>
    </view>
    <scroll-view scroll-x="true" class="shop-scroll">
      <view class="shop-list">
        <view class="shop-item" wx:for="{{shops}}" wx:key="id" bindtap="onShopTap" data-id="{{item.id}}">
          <image src="{{item.logo}}" mode="aspectFill" class="shop-logo"></image>
          <text class="shop-name">{{item.name}}</text>
          <text class="shop-category">{{item.category}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 积分任务 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">赚积分</text>
      <text class="section-more" bindtap="goToMoreTasks">全部任务 ></text>
    </view>
    <view class="task-list">
      <view class="task-item" wx:for="{{tasks}}" wx:key="id">
        <view class="task-icon">
          <text class="iconfont {{item.icon}}"></text>
        </view>
        <view class="task-content">
          <text class="task-title">{{item.title}}</text>
          <text class="task-desc">{{item.desc}}</text>
        </view>
        <view class="task-reward">
          <text class="reward-points">+{{item.points}}</text>
          <text class="reward-label">积分</text>
        </view>
        <button class="task-btn {{item.completed ? 'completed' : ''}}" bindtap="doTask" data-id="{{item.id}}" disabled="{{item.completed}}">
          {{item.completed ? '已完成' : '去完成'}}
        </button>
      </view>
    </view>
  </view>
</view>
