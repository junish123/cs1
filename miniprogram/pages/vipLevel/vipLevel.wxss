/* 会员等级页面样式 */
.container {
  background: #F5F7FA;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 当前等级卡片 */
.current-level-card {
  margin: 20rpx;
  padding: 40rpx 30rpx;
  border-radius: 24rpx;
  color: #fff;
}

.level-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.level-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.level-badge {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
}

.level-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.level-progress-section {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.progress-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.progress-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFD700;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFD700, #FFA500);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.progress-labels {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.level-stats {
  display: flex;
  justify-content: space-around;
}

.level-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.level-stat .stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
}

.level-stat .stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFD700;
}

/* 等级列表 */
.level-list-section, .compare-section {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 30rpx;
}

.level-item {
  display: flex;
  margin-bottom: 30rpx;
}

.level-item.current {
  background: rgba(233, 69, 96, 0.05);
  border-radius: 16rpx;
  padding: 20rpx;
  margin: -20rpx;
  margin-bottom: 10rpx;
}

.level-icon-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}

.level-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.level-icon .iconfont {
  font-size: 40rpx;
  color: #fff;
}

.level-connector {
  width: 4rpx;
  flex: 1;
  background: #E8E8E8;
  margin: 8rpx 0;
}

.level-content {
  flex: 1;
}

.level-content-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.level-content-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-right: 16rpx;
}

.level-tag {
  font-size: 22rpx;
  color: #E94560;
  background: rgba(233, 69, 96, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.level-condition {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.level-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.benefit-item .iconfont {
  font-size: 24rpx;
  color: #10B981;
  margin-right: 8rpx;
}

/* 权益对比表 */
.compare-table {
  border: 1rpx solid #E8E8E8;
  border-radius: 16rpx;
  overflow: hidden;
}

.compare-header, .compare-row {
  display: flex;
  border-bottom: 1rpx solid #E8E8E8;
}

.compare-row:last-child {
  border-bottom: none;
}

.compare-header {
  background: #F8F9FA;
}

.compare-cell {
  flex: 1;
  padding: 20rpx 16rpx;
  text-align: center;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.compare-header .compare-cell {
  font-weight: 600;
  color: #333;
}

.compare-cell:first-child {
  flex: 1.5;
  text-align: left;
  justify-content: flex-start;
}

.benefit-name {
  color: #666;
}

.compare-cell .icon-check {
  color: #10B981;
  font-size: 28rpx;
}

.compare-cell .icon-minus {
  color: #CCC;
  font-size: 28rpx;
}

.benefit-value {
  color: #E94560;
  font-weight: 600;
}
