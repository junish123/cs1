<view class="container">
  <!-- 积分概览 -->
  <view class="point-overview">
    <view class="point-card">
      <text class="point-label">当前积分</text>
      <text class="point-value">{{memberInfo.points || 0}}</text>
      <text class="point-tip">积分可用于兑换商品、抵扣现金</text>
    </view>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <view class="tab-item {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">
      <text>全部</text>
    </view>
    <view class="tab-item {{currentTab === 'income' ? 'active' : ''}}" bindtap="switchTab" data-tab="income">
      <text>收入</text>
    </view>
    <view class="tab-item {{currentTab === 'expense' ? 'active' : ''}}" bindtap="switchTab" data-tab="expense">
      <text>支出</text>
    </view>
  </view>

  <!-- 积分记录列表 -->
  <view class="record-list">
    <view class="record-item" wx:for="{{filteredRecords}}" wx:key="id">
      <view class="record-icon-wrapper">
        <view class="record-icon {{item.type === 'income' ? 'income' : 'expense'}}">
          <text class="iconfont {{item.icon}}"></text>
        </view>
      </view>
      <view class="record-content">
        <view class="record-header">
          <text class="record-title">{{item.title}}</text>
          <text class="record-points {{item.type}}">{{item.type === 'income' ? '+' : '-'}}{{item.points}}</text>
        </view>
        <text class="record-desc">{{item.desc}}</text>
        <text class="record-time">{{item.time}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredRecords.length === 0}}">
    <image src="/images/empty-points.png" class="empty-image" mode="aspectFit"></image>
    <text class="empty-text">暂无积分记录</text>
  </view>

  <!-- 赚积分入口 -->
  <view class="earn-point-section">
    <view class="section-title">赚积分</view>
    <view class="task-list">
      <view class="task-card" wx:for="{{tasks}}" wx:key="id" bindtap="doTask" data-id="{{item.id}}">
        <view class="task-left">
          <view class="task-icon" style="background: {{item.bgColor}};">
            <text class="iconfont {{item.icon}}"></text>
          </view>
          <view class="task-info">
            <text class="task-title">{{item.title}}</text>
            <text class="task-desc">{{item.desc}}</text>
          </view>
        </view>
        <view class="task-right">
          <text class="task-points">+{{item.points}}</text>
          <button class="task-btn {{item.completed ? 'completed' : ''}}" disabled="{{item.completed}}">
            {{item.completed ? '已完成' : '去完成'}}
          </button>
        </view>
      </view>
    </view>
  </view>
</view>
