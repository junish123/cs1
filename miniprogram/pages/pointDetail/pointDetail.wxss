/* 积分明细页面样式 */
.container {
  background: #F5F7FA;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 积分概览 */
.point-overview {
  padding: 30rpx;
  background: linear-gradient(135deg, #1A1A2E 0%, #16213E 100%);
}

.point-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
}

.point-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 16rpx;
}

.point-value {
  font-size: 72rpx;
  font-weight: 700;
  color: #FFD700;
  margin-bottom: 16rpx;
}

.point-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.tab-item {
  padding: 16rpx 40rpx;
  margin-right: 20rpx;
  border-radius: 32rpx;
  background: #F5F7FA;
}

.tab-item text {
  font-size: 28rpx;
  color: #666;
}

.tab-item.active {
  background: linear-gradient(135deg, #E94560, #FF6B6B);
}

.tab-item.active text {
  color: #fff;
}

/* 记录列表 */
.record-list {
  background: #fff;
  padding: 0 30rpx;
}

.record-item {
  display: flex;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-icon-wrapper {
  margin-right: 24rpx;
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-icon.income {
  background: rgba(16, 185, 129, 0.1);
}

.record-icon.expense {
  background: rgba(233, 69, 96, 0.1);
}

.record-icon .iconfont {
  font-size: 36rpx;
}

.record-icon.income .iconfont {
  color: #10B981;
}

.record-icon.expense .iconfont {
  color: #E94560;
}

.record-content {
  flex: 1;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.record-points {
  font-size: 32rpx;
  font-weight: 700;
}

.record-points.income {
  color: #10B981;
}

.record-points.expense {
  color: #E94560;
}

.record-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
  display: block;
}

.record-time {
  font-size: 24rpx;
  color: #CCC;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: #fff;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 赚积分区域 */
.earn-point-section {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 24rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #F8F9FA;
  border-radius: 20rpx;
}

.task-left {
  display: flex;
  align-items: center;
}

.task-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.task-icon .iconfont {
  font-size: 40rpx;
  color: #fff;
}

.task-info {
  display: flex;
  flex-direction: column;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.task-desc {
  font-size: 24rpx;
  color: #999;
}

.task-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.task-points {
  font-size: 36rpx;
  font-weight: 700;
  color: #E94560;
  margin-bottom: 8rpx;
}

.task-btn {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #E94560, #FF6B6B);
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  border: none;
  line-height: 1.5;
}

.task-btn.completed {
  background: #CCC;
}

.task-btn::after {
  border: none;
}
